<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>معرض المنتجات والصور</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/style.css?v=<%= Date.now() %>" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
<style>
/* ===== Gallery Grid Cards ===== */
.gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 20px;
    margin-top: 20px;
}
.gallery-card {
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    overflow: hidden;
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
    position: relative;
}
.gallery-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(54,153,255,0.18);
    border-color: rgba(54,153,255,0.4);
}
.gallery-card-imgs {
    position: relative;
    height: 160px;
    background: #1a1a2e;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}
.gallery-card-imgs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
}
.gallery-card:hover .gallery-card-imgs img {
    transform: scale(1.05);
}
.gallery-img-count {
    position: absolute;
    bottom: 8px;
    left: 10px;
    background: rgba(0,0,0,0.65);
    color: #fff;
    font-size: 11px;
    padding: 2px 8px;
    border-radius: 20px;
    backdrop-filter: blur(4px);
}
.gallery-card-body {
    padding: 14px 16px;
}
.gallery-card-name {
    font-weight: 700;
    font-size: 15px;
    color: #e4e6ef;
    margin-bottom: 8px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.gallery-card-kw {
    font-size: 11px;
    color: #8899ac;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.gallery-card-actions {
    display: flex;
    gap: 6px;
    padding: 10px 16px 14px;
    justify-content: flex-end;
}
/* No-image placeholder */
.gallery-no-img {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.2);
    font-size: 40px;
}
/* Upload Zone */
.gallery-upload-zone {
    border: 2px dashed rgba(54,153,255,0.4);
    border-radius: 14px;
    padding: 32px 20px;
    text-align: center;
    cursor: pointer;
    transition: all 0.3s;
    background: rgba(54,153,255,0.03);
}
.gallery-upload-zone:hover, .gallery-upload-zone.dragging {
    border-color: #3699ff;
    background: rgba(54,153,255,0.08);
}
.gallery-upload-icon { font-size: 2.5rem; color: #3699ff; margin-bottom: 10px; }
.gallery-upload-text { font-weight: 600; color: #c0c5d0; font-size: 15px; }
.gallery-upload-subtext { font-size: 12px; color: #5a6070; margin-top: 6px; }
/* Preview grid inside modal */
.img-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    gap: 10px;
    margin-top: 14px;
}
.img-preview-item {
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    aspect-ratio: 1;
}
.img-preview-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}
.img-preview-remove {
    position: absolute;
    top: 4px;
    left: 4px;
    background: rgba(200,50,50,0.85);
    border: none;
    color: white;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-size: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: 0.2s;
}
.img-preview-remove:hover { background: #e30; }
/* Empty state */
.gallery-empty {
    text-align: center;
    padding: 60px 20px;
    color: rgba(255,255,255,0.25);
}
.gallery-empty i { font-size: 5rem; display: block; margin-bottom: 16px; }
</style>
</head>
<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar') %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success success-msg shadow-lg rounded-pill px-5" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> تم الحفظ بنجاح!
        </div>
        <script>setTimeout(() => { window.location.href = '/dashboard/gallery'; }, 1500);</script>
    <% } %>

    <div class="container-fluid main-content px-4 px-lg-5">
        <div class="glass-card p-4 p-md-5 animate-fade-in">

            <!-- Header -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-4 gap-3">
                <div>
                    <h2 class="m-0 fw-bold text-white d-flex align-items-center gap-2">
                        <i class="bi bi-images text-primary"></i>
                        معرض الصور والمنتجات
                    </h2>
                    <p class="text-white-50 small mt-1 mb-0">ارفع الصور واكتب اسم المنتج فقط — البوت يتعلم الباقي تلقائياً 🤖</p>
                </div>
                <button class="btn btn-primary px-4 rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#addModal">
                    <i class="bi bi-plus-lg me-1"></i> إضافة منتج / خدمة
                </button>
            </div>

            <!-- Gallery Grid -->
            <% if (instructions.length === 0) { %>
                <div class="gallery-empty glass-card" style="background: rgba(255,255,255,0.02);">
                    <i class="bi bi-image"></i>
                    <h5 class="text-white-50">لا يوجد منتجات مصورة بعد</h5>
                    <p class="text-white-50 small">ابدأ بإضافة أول منتج أو خدمة</p>
                    <button class="btn btn-outline-primary rounded-pill px-4 mt-2" data-bs-toggle="modal" data-bs-target="#addModal">
                        <i class="bi bi-plus-circle me-1"></i> إضافة الآن
                    </button>
                </div>
            <% } else { %>
                <div class="gallery-grid">
                    <% instructions.forEach(inst => {
                        let images = [];
                        try {
                            if (inst.imageUrl && inst.imageUrl.startsWith('[')) {
                                images = JSON.parse(inst.imageUrl);
                            } else if (inst.imageUrl) {
                                images = [{ url: inst.imageUrl, description: inst.clientName }];
                            }
                        } catch(e) { images = []; }
                    %>
                    <div class="gallery-card">
                        <div class="gallery-card-imgs">
                            <% if (images.length > 0) { %>
                                <img src="<%= images[0].url %>" alt="<%= inst.clientName %>" loading="lazy">
                                <% if (images.length > 1) { %>
                                    <span class="gallery-img-count"><i class="bi bi-images"></i> <%= images.length %> صور</span>
                                <% } %>
                            <% } else { %>
                                <div class="gallery-no-img">
                                    <i class="bi bi-image-alt"></i>
                                    <span style="font-size:13px; margin-top:8px;">لا توجد صور</span>
                                </div>
                            <% } %>
                        </div>
                        <div class="gallery-card-body">
                            <div class="gallery-card-name"><%= inst.clientName %></div>
                            <% if (inst.keywords) { %>
                                <div class="gallery-card-kw">🏷️ <%= inst.keywords %></div>
                            <% } %>
                        </div>
                        <div class="gallery-card-actions">
                            <button class="btn btn-sm btn-outline-info rounded-pill px-3"
                                onclick="openEditModal(this)"
                                data-id="<%= inst.id %>"
                                data-name="<%= inst.clientName %>"
                                data-imageurl='<%= inst.imageUrl || "[]" %>'
                                title="تعديل">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <form action="/dashboard/gallery/delete" method="POST" class="m-0 d-inline"
                                onsubmit="return confirm('حذف <%= inst.clientName %>؟')">
                                <input type="hidden" name="id" value="<%= inst.id %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="حذف">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- ====== Add Modal (Simple) ====== -->
    <div class="modal fade" id="addModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title text-white fw-bold"><i class="bi bi-plus-circle-fill text-primary me-2"></i>إضافة منتج / خدمة مصورة</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/dashboard/gallery/add" method="POST">
                    <div class="modal-body p-4">

                        <!-- Product Name (Only Required Field) -->
                        <div class="mb-4">
                            <label class="form-label text-white fw-bold fs-6">
                                🏷️ اسم المنتج أو الخدمة
                                <span class="badge bg-danger ms-1">مطلوب</span>
                            </label>
                            <input type="text" name="clientName" id="addClientName"
                                class="form-control form-control-lg bg-dark text-white border-secondary"
                                required placeholder="مثال: جينز كلاسيك أسود، خدمة التوصيل، فستان سواريه أحمر..."
                                autofocus>
                            <div class="form-text text-white-50 mt-1">
                                ✨ البوت هيتعلم الكلمات المفتاحية والوصف من الاسم تلقائياً
                            </div>
                        </div>

                        <!-- Image Upload Zone -->
                        <div class="mb-3">
                            <label class="form-label text-white fw-bold fs-6">🖼️ الصور</label>
                            <div class="gallery-upload-zone" id="addDropZone">
                                <div class="gallery-upload-icon"><i class="bi bi-cloud-upload"></i></div>
                                <div class="gallery-upload-text">اضغط هنا أو اسحب الصور</div>
                                <div class="gallery-upload-subtext">PNG, JPG, WEBP — ممكن تختار أكتر من صورة</div>
                                <div class="mt-3" style="min-height:20px;">
                                    <span class="spinner-border spinner-border-sm text-primary d-none" id="addSpinner"></span>
                                    <span id="addStatus" class="small text-success fw-bold"></span>
                                </div>
                            </div>
                            <input type="hidden" name="imageUrl" id="addImageUrlInput">
                            <input type="file" id="addFileInput" accept="image/*" multiple class="d-none">
                            <div id="addPreviewGrid" class="img-preview-grid"></div>
                        </div>

                    </div>
                    <div class="modal-footer border-top border-secondary border-opacity-25 justify-content-between">
                        <button type="button" class="btn btn-link text-white-50 text-decoration-none" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" id="addSubmitBtn" class="btn btn-primary px-5 rounded-pill fw-bold">
                            <i class="bi bi-check-lg me-1"></i> إضافة للمعرض
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- ====== Edit Modal (Simple) ====== -->
    <div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" style="background: #1e293b; border: 1px solid rgba(255,255,255,0.1); box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5);">
                <div class="modal-header border-bottom border-secondary border-opacity-25">
                    <h5 class="modal-title text-white fw-bold"><i class="bi bi-pencil-square text-info me-2"></i>تعديل المنتج</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <form action="/dashboard/gallery/edit" method="POST">
                    <input type="hidden" name="id" id="editId">
                    <div class="modal-body p-4">

                        <div class="mb-4">
                            <label class="form-label text-white fw-bold fs-6">🏷️ اسم المنتج أو الخدمة</label>
                            <input type="text" name="clientName" id="editClientName"
                                class="form-control form-control-lg bg-dark text-white border-secondary"
                                required placeholder="اسم المنتج...">
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-white fw-bold fs-6">🖼️ الصور الحالية والجديدة</label>
                            <div class="gallery-upload-zone" id="editDropZone">
                                <div class="gallery-upload-icon"><i class="bi bi-cloud-upload"></i></div>
                                <div class="gallery-upload-text">اسحب صور جديدة هنا أو اضغط للإضافة</div>
                                <div class="gallery-upload-subtext">الصور القديمة ستبقى إلا لو حذفتها</div>
                                <div class="mt-3" style="min-height:20px;">
                                    <span class="spinner-border spinner-border-sm text-primary d-none" id="editSpinner"></span>
                                    <span id="editStatus" class="small text-success fw-bold"></span>
                                </div>
                            </div>
                            <input type="hidden" name="imageUrl" id="editImageUrlInput">
                            <input type="file" id="editFileInput" accept="image/*" multiple class="d-none">
                            <div id="editPreviewGrid" class="img-preview-grid"></div>
                        </div>

                    </div>
                    <div class="modal-footer border-top border-secondary border-opacity-25 justify-content-between">
                        <button type="button" class="btn btn-link text-white-50 text-decoration-none" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-info px-5 rounded-pill fw-bold text-dark">
                            <i class="bi bi-check-lg me-1"></i> حفظ التعديلات
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
    // ===== Shared Upload Logic =====
    function createUploadManager(dropZoneId, fileInputId, previewGridId, hiddenInputId, spinnerId, statusId) {
        const dropZone   = document.getElementById(dropZoneId);
        const fileInput  = document.getElementById(fileInputId);
        const previewGrid = document.getElementById(previewGridId);
        const hiddenInput = document.getElementById(hiddenInputId);
        const spinner    = document.getElementById(spinnerId);
        const statusEl   = document.getElementById(statusId);

        let uploadedImages = []; // [{url, description}]

        const syncHidden = () => {
            hiddenInput.value = JSON.stringify(uploadedImages);
        };

        const renderPreviews = () => {
            previewGrid.innerHTML = '';
            uploadedImages.forEach((img, idx) => {
                const item = document.createElement('div');
                item.className = 'img-preview-item';
                item.innerHTML = `
                    <img src="${img.url}" alt="${img.description}" loading="lazy">
                    <button type="button" class="img-preview-remove" onclick="removeImg_${dropZoneId}(${idx})" title="حذف">×</button>
                `;
                previewGrid.appendChild(item);
            });
        };

        window[`removeImg_${dropZoneId}`] = (idx) => {
            uploadedImages.splice(idx, 1);
            syncHidden();
            renderPreviews();
        };

        const uploadFiles = async (files) => {
            if (!files || files.length === 0) return;
            spinner.classList.remove('d-none');
            statusEl.textContent = '';

            let uploaded = 0;
            for (const file of files) {
                const formData = new FormData();
                formData.append('image', file);
                try {
                    const res = await fetch('/dashboard/instructions/upload-image', { method: 'POST', body: formData });
                    const data = await res.json();
                    if (data.imageUrl) {
                        uploadedImages.push({ url: data.imageUrl, description: file.name.replace(/\.[^.]+$/, '') });
                        uploaded++;
                    }
                } catch (e) {
                    console.error('Upload failed:', e);
                }
            }

            spinner.classList.add('d-none');
            statusEl.textContent = uploaded > 0 ? `✅ تم رفع ${uploaded} صورة` : '❌ فشل الرفع';
            syncHidden();
            renderPreviews();
        };

        // Click to upload
        dropZone.addEventListener('click', () => fileInput.click());
        fileInput.addEventListener('change', () => uploadFiles(fileInput.files));

        // Drag & drop
        dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('dragging'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragging'));
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('dragging');
            uploadFiles(e.dataTransfer.files);
        });

        return {
            setImages: (imgs) => {
                uploadedImages = imgs;
                syncHidden();
                renderPreviews();
            },
            getImages: () => uploadedImages
        };
    }

    // Init Add Manager
    const addManager = createUploadManager('addDropZone', 'addFileInput', 'addPreviewGrid', 'addImageUrlInput', 'addSpinner', 'addStatus');

    // Init Edit Manager
    const editManager = createUploadManager('editDropZone', 'editFileInput', 'editPreviewGrid', 'editImageUrlInput', 'editSpinner', 'editStatus');

    // Reset add modal on open
    document.getElementById('addModal').addEventListener('show.bs.modal', () => {
        document.getElementById('addClientName').value = '';
        addManager.setImages([]);
    });

    // Open edit modal
    window.openEditModal = function(btn) {
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const imageUrlRaw = btn.getAttribute('data-imageurl');

        document.getElementById('editId').value = id;
        document.getElementById('editClientName').value = name;

        let images = [];
        try {
            if (imageUrlRaw && imageUrlRaw.startsWith('[')) {
                images = JSON.parse(imageUrlRaw);
            } else if (imageUrlRaw) {
                images = [{ url: imageUrlRaw, description: name }];
            }
        } catch(e) {}

        editManager.setImages(images);

        new bootstrap.Modal(document.getElementById('editModal')).show();
    };
    </script>
</body>
</html>