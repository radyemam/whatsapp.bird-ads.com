<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>رسائل جماعية — لينا بوت</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <link href="/style.css" rel="stylesheet">
    <style>
        .bc-wrapper .glass-card { max-width: 100% !important; margin: 0 !important; }

        .stat-card {
            background: rgba(30,41,59,.6); border: 1px solid rgba(255,255,255,.08);
            border-radius: 14px; padding: 18px 20px;
            display: flex; align-items: center; gap: 14px;
        }
        .stat-icon { width:46px; height:46px; border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:20px; flex-shrink:0; }
        .stat-value { font-size:1.7rem; font-weight:800; color:#f1f5f9; line-height:1; }
        .stat-label { font-size:11px; color:#64748b; margin-top:4px; }

        .campaign-card {
            background: rgba(15,23,42,0.6);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 12px;
            padding: 16px;
            margin-bottom: 12px;
            transition: all 0.2s;
        }
        .campaign-card:hover { background: rgba(30,41,59,0.8); }
        .cmp-title { font-weight: 600; font-size: 14px; color: #f8fafc; }
        .cmp-date { font-size: 11px; color: #64748b; }
        .cmp-msg { font-size: 12px; color: #cbd5e1; margin-top: 8px; white-space: pre-wrap; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        
        .prog-bar { height: 6px; background: rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden; margin-top: 12px; }
        .prog-fill { height: 100%; background: #6366f1; border-radius: 4px; transition: width 0.3s; }
        
        .badge-status-running { background: rgba(56,189,248,0.15); color: #38bdf8; border: 1px solid rgba(56,189,248,0.3); }
        .badge-status-completed { background: rgba(16,185,129,0.15); color: #10b981; border: 1px solid rgba(16,185,129,0.3); }
        .badge-status-failed { background: rgba(239,68,68,0.15); color: #ef4444; border: 1px solid rgba(239,68,68,0.3); }
        
        .cmp-metrics { display: flex; gap: 16px; margin-top: 12px; font-size: 12px; }
        .cmp-metric { display: flex; align-items: center; gap: 4px; }

        .modal-content { background: #0f172a; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px; }
        .modal-header { border-bottom: 1px solid rgba(255,255,255,0.05); }
        .modal-footer { border-top: 1px solid rgba(255,255,255,0.05); }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>
    <%- include('partials/sidebar', { handoffCount: handoffCount || 0 }) %>

    <div class="container-fluid main-content px-4 px-lg-5 pb-5 animate-fade-in bc-wrapper">
        <div class="d-flex flex-wrap align-items-center justify-content-between mb-4 gap-3">
            <div>
                <h5 class="fw-bold text-white m-0"><i class="bi bi-megaphone-fill me-2" style="color:#6366f1;"></i>رسائل جماعية (Broadcast)</h5>
                <p class="text-white-50 small m-0">إرسال العروض والتحديثات لعملائك</p>
            </div>
            <button class="btn btn-primary fw-semibold" style="font-size:13px; border-radius:8px;" data-bs-toggle="modal" data-bs-target="#newCampaignModal">
                <i class="bi bi-plus-lg me-1"></i>حملة جديدة
            </button>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6 col-lg-4">
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(99,102,241,.15);">👥</div>
                    <div>
                        <div class="stat-value"><%= targetCount %></div>
                        <div class="stat-label">إجمالي العملاء المتاحين</div>
                    </div>
                </div>
            </div>
            <div class="col-md-6 col-lg-4">
                <div class="stat-card">
                    <div class="stat-icon" style="background:rgba(16,185,129,.15);">🚀</div>
                    <div>
                        <div class="stat-value"><%= campaigns.length %></div>
                        <div class="stat-label">إجمالي الحملات</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="glass-card p-4" style="border-radius:16px;">
            <h6 class="fw-bold mb-4 text-white">سجل الحملات</h6>
            
            <% if (campaigns.length === 0) { %>
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-rocket-takeoff" style="font-size:3rem; opacity:0.3; display:block; margin-bottom:10px;"></i>
                    <p style="font-size:14px;">لا توجد حملات سابقة. ابدأ بإرسال حملتك الأولى!</p>
                </div>
            <% } else { %>
                <div class="row">
                    <% campaigns.forEach(cmp => { 
                        const pct = cmp.targetCount > 0 ? Math.round(((cmp.sentCount+cmp.failedCount) / cmp.targetCount) * 100) : 0;
                        let badgeCls = 'badge-status-running';
                        let statTxt = 'قيد الإرسال';
                        if(cmp.status === 'completed') { badgeCls = 'badge-status-completed'; statTxt = 'مكتمل'; }
                        if(cmp.status === 'failed') { badgeCls = 'badge-status-failed'; statTxt = 'فشل'; }
                    %>
                    <div class="col-lg-6">
                        <div class="campaign-card">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <div class="cmp-title">
                                        <% if(cmp.platform === 'messenger') { %>
                                            <i class="bi bi-messenger text-primary me-1"></i>
                                        <% } else { %>
                                            <i class="bi bi-whatsapp text-success me-1"></i>
                                        <% } %>
                                        <%= cmp.name %>
                                    </div>
                                    <div class="cmp-date"><%= cmp.createdAt.toLocaleString('ar-EG') %></div>
                                </div>
                                <span class="badge rounded-pill <%= badgeCls %>" style="font-size:11px;"><%= statTxt %></span>
                            </div>
                            <div class="cmp-msg"><%= cmp.message %></div>
                            
                            <div class="prog-bar">
                                <div class="prog-fill" style="width: <%= pct %>%"></div>
                            </div>
                            
                            <div class="cmp-metrics text-muted">
                                <div class="cmp-metric"><i class="bi bi-people-fill"></i> المستهدفين: <%= cmp.targetCount %></div>
                                <div class="cmp-metric text-success"><i class="bi bi-check-circle-fill"></i> نجح: <%= cmp.sentCount %></div>
                                <% if (cmp.failedCount > 0) { %>
                                <div class="cmp-metric text-danger"><i class="bi bi-x-circle-fill"></i> فشل: <%= cmp.failedCount %></div>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <% }) %>
                </div>
            <% } %>
        </div>
    </div>

    <!-- New Campaign Modal -->
    <div class="modal fade" id="newCampaignModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title fw-bold text-white"><i class="bi bi-rocket-takeoff me-2 text-primary"></i>إرسال حملة جديدة</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="campaignForm">
                        <div class="mb-3">
                            <label class="form-label text-white-50" style="font-size:12px;">اسم الحملة (للتعرف عليها داخلياً)</label>
                            <input type="text" class="form-control bg-dark text-white border-secondary" id="cmpName" placeholder="مثال: عرض البلاك فرايداي" required>
                        </div>
                        
                        <div class="mb-3">
                            <label class="form-label text-white-50" style="font-size:12px;">رسالة الحملة</label>
                            <textarea class="form-control bg-dark text-white border-secondary" id="cmpMsg" rows="5" placeholder="اكتب رسالتك لعملائك هنا..." required></textarea>
                            <div class="form-text text-muted" style="font-size:11px; margin-top:6px;">ملاحظة: يمكنك استخدام تنسيقات الواتساب النجمية *غامق*</div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label text-white-50" style="font-size:12px;">تطبيق المراسلة</label>
                                <select class="form-select bg-dark text-white border-secondary" id="cmpPlatform">
                                    <option value="whatsapp">واتساب (WhatsApp)</option>
                                    <option value="messenger">ماسنجر (Messenger)</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-white-50" style="font-size:12px;">الجمهور المستهدف</label>
                                <select class="form-select bg-dark text-white border-secondary" id="cmpTarget">
                                    <option value="0">كل العملاء (<%= targetCount %>)</option>
                                    <option value="7">تفاعلوا آخر 7 أيام</option>
                                    <option value="30">تفاعلوا آخر 30 يوم</option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="form-label text-white-50" style="font-size:12px;">وقت الانتظار التقريبي (أقل وقت بالثانية)</label>
                                <input type="number" class="form-control bg-dark text-white border-secondary" id="cmpMinDelay" value="30" min="1" required>
                            </div>
                            <div class="col-6">
                                <label class="form-label text-white-50" style="font-size:12px;">أقصى وقت (بالثانية)</label>
                                <input type="number" class="form-control bg-dark text-white border-secondary" id="cmpMaxDelay" value="60" min="1" required>
                            </div>
                        </div>

                        <div class="alert alert-warning p-3 mt-4" style="background:rgba(245,158,11,0.1);border:1px solid rgba(245,158,11,0.2);color:#fbbf24;font-size:12px;">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            <strong>تنبيه لتجنب الحظر:</strong> سيتم الإرسال بفواصل زمنية عشوائية بين أدنى وأقصى وقت مضاف أعلاه. يُنصح بأن يكون الإرسال كل <b>60 ثانية</b> لتجنب اكتشاف واتساب وحظر الرقم. ستعمل الحملة في الخلفية بأمان.
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" style="font-size:13px;">تراجع</button>
                    <button type="button" class="btn btn-primary fw-semibold" id="btnSend" onclick="submitCampaign()" style="font-size:13px;">
                        <i class="bi bi-send-fill me-1"></i>بدء الإرسال
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        async function submitCampaign() {
            const name = document.getElementById('cmpName').value.trim();
            const msg = document.getElementById('cmpMsg').value.trim();
            const filter = document.getElementById('cmpTarget').value;
            const platform = document.getElementById('cmpPlatform').value;
            const minDelay = parseInt(document.getElementById('cmpMinDelay').value) || 30;
            const maxDelay = parseInt(document.getElementById('cmpMaxDelay').value) || 60;
            
            if (!name || !msg) return alert('يرجى ملء جميع الحقول المطلوبة');
            if (minDelay > maxDelay) return alert('أقل وقت انتظار لا يمكن أن يكون أكبر من أقصى وقت انتظار');
            
            const btn = document.getElementById('btnSend');
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>جاري المعالجة...';
            btn.disabled = true;

            try {
                const res = await fetch('/dashboard/broadcast/send', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name, message: msg, filterDays: parseInt(filter), platform, minDelay, maxDelay })
                });
                const data = await res.json();
                
                if (data.success) {
                    alert('✅ ' + data.message);
                    window.location.reload();
                } else {
                    alert('❌ خطأ: ' + (data.error || 'فشل في الإرسال'));
                    btn.innerHTML = '<i class="bi bi-send-fill me-1"></i>بدء الإرسال';
                    btn.disabled = false;
                }
            } catch (err) {
                alert('❌ حدث خطأ غير متوقع');
                btn.innerHTML = '<i class="bi bi-send-fill me-1"></i>بدء الإرسال';
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
